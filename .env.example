# Agent OS 环境变量配置
# 所有变量以 AGENT_OS_ 为前缀，支持 config.yaml 中的所有字段

# 网关配置（必填）
AGENT_OS_GATEWAY_BASE_URL=https://api.deepseek.com
AGENT_OS_GATEWAY_API_KEY=sk-xxx
AGENT_OS_GATEWAY_DEFAULT_MODEL=deepseek-v4-flash

# Embedding 配置（硅基流动 OneAPI 兼容，可选）
AGENT_OS_EMBEDDING_ENABLED=true
AGENT_OS_EMBEDDING_PROVIDER=oneapi
AGENT_OS_EMBEDDING_ONEAPI_BASE_URL=https://api.siliconflow.cn/v1
AGENT_OS_EMBEDDING_ONEAPI_MODEL=Qwen/Qwen3-Embedding-4B
AGENT_OS_EMBEDDING_ONEAPI_API_KEY=sk-xxx

# 输出目录
AGENT_OS_OUTPUT_DIRECTORY=./data/output

# 日志级别
RUST_LOG=info

# 严格模式下 MCP 出站 origin 白名单 / MCP outbound origin allowlist for strict mode
# AGENTOS_AUTH_STRICT=true
# MCP_OUTBOUND_ALLOWED_ORIGINS=https://mcp.example.test
